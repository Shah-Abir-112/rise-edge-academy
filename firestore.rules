rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function currentRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : '';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn() && uid == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','phone','dateOfBirth','gender','fatherName','motherName','guardianName',
          'guardianPhone','address','emergencyContact','profilePicture','additionalInfo',
          'qualification','experience','specialization','bio','updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /admissions/{id} { allow read, write: if isAdmin(); }
    match /activity/{id} { allow read, write: if isAdmin(); }

    match /{collection}/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && (request.resource.data.studentUid == request.auth.uid || request.resource.data.teacherUid == request.auth.uid || request.resource.data.userId == request.auth.uid));
      allow update: if isAdmin() || (signedIn() && (resource.data.studentUid == request.auth.uid || resource.data.teacherUid == request.auth.uid || resource.data.userId == request.auth.uid || request.resource.data.studentUid == request.auth.uid || request.resource.data.teacherUid == request.auth.uid || request.resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }
  }
}
